{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "packages/web/src",
    "packages/core/src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/web/dist",
    ".git",
    ".gemini",
    "scratch",
    "**/*.spec.ts"
  ]
}